#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

command -v sbx >/dev/null || { echo "error: sbx is required" >&2; exit 1; }

mkdir -p "$BACKUP_DIR"
chmod 700 "$BACKUP_DIR"

stamp=$(date -u +%Y%m%dT%H%M%SZ)
final="$BACKUP_DIR/hermes-$stamp.zip"
suffix=1
while [[ -e $final ]]; do
  final="$BACKUP_DIR/hermes-$stamp-$suffix.zip"
  ((suffix += 1))
done
remote_file="/tmp/$(basename "$final")"
partial="$final.partial"

cleanup() {
  rm -f "$partial"
  sbx env exec "$ENV_FILE" -- rm -f "$remote_file" >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "Creating consistent Hermes snapshot in $SANDBOX_NAME..."
sbx env exec "$ENV_FILE" -- hermes backup -o "$remote_file"

echo "Copying snapshot to protected host storage..."
sbx cp "$SANDBOX_NAME:$remote_file" "$partial"
chmod 600 "$partial"
mv "$partial" "$final"
ln -sfn "$(basename "$final")" "$BACKUP_DIR/latest.zip"

sbx env exec "$ENV_FILE" -- rm -f "$remote_file"
trap - EXIT

printf 'Backup complete: %s\n' "$final"
