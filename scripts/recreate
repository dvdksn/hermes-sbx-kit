#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

"$SCRIPT_DIR/backup"

printf 'Removing and recreating %s...\n' "$SANDBOX_NAME"
sbx env rm "$ENV_FILE" --force
sbx env create "$ENV_FILE"

"$SCRIPT_DIR/restore" "$BACKUP_DIR/latest.zip"

exec sbx env run "$ENV_FILE"
