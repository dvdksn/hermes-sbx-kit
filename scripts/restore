#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
# shellcheck source=lib.sh
source "$SCRIPT_DIR/lib.sh"

command -v sbx >/dev/null || { echo "error: sbx is required" >&2; exit 1; }

backup_file=${1:-$BACKUP_DIR/latest.zip}
if [[ ! -f $backup_file ]]; then
  echo "error: backup not found: $backup_file" >&2
  echo "Run scripts/backup first or pass a backup ZIP explicitly." >&2
  exit 1
fi

remote_file="/tmp/hermes-restore-$(date -u +%Y%m%dT%H%M%SZ).zip"
cleanup() {
  sbx env exec "$ENV_FILE" -- rm -f "$remote_file" >/dev/null 2>&1 || true
}
trap cleanup EXIT

echo "Copying $(basename "$backup_file") into $SANDBOX_NAME..."
sbx cp "$backup_file" "$SANDBOX_NAME:$remote_file"

echo "Restoring Hermes state..."
sbx env exec "$ENV_FILE" -- hermes import --force "$remote_file"
sbx env exec "$ENV_FILE" -- rm -f "$remote_file"
trap - EXIT

# Ensure the next agent session reloads restored config, memory, and state.
sbx stop "$SANDBOX_NAME" >/dev/null

printf 'Restore complete: %s\n' "$backup_file"
printf 'The sandbox is stopped. Run: sbx env run %q\n' "$ENV_FILE"
